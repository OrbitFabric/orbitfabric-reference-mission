{
  "$id": "orbitfabric.reference_mission.pwnsat_experiment_definition/0.2-story",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R2 PWNSAT Runtime Experiment Definition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "orbitfabric.reference_mission.pwnsat_experiment_definition"},
    "format_version": {"const": "0.2-story"},
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
      },
      "required": ["id", "version"]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"const": "r2_g0_health_check"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "atom_id": {"const": "atom-0003"},
        "command_id": {"const": "obc.request_health_check"}
      },
      "required": ["id", "sha256", "atom_id", "command_id"]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iiss_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stimulus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scenario_accounting_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "integration_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["iiss_sha256", "profile_sha256", "source_baseline_sha256", "mapping_sha256", "stimulus_sha256", "scenario_accounting_sha256", "integration_result_sha256"]
    },
    "authorized_instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "scope": {"const": "execution_attempt"},
        "expected_execution_count": {"const": 1}
      },
      "required": ["local_id", "scope", "expected_execution_count"]
    },
    "runtime_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"const": "Pwnsat/FlatSat"},
        "source_commit": {"const": "b5ac0f2ba5e7bd60fbb6994f681c28053777628e"},
        "transport": {"const": "usb_cdc_serial"},
        "path": {"const": "wired_local"},
        "rf": {"const": false}
      },
      "required": ["repository", "source_commit", "transport", "path", "rf"]
    },
    "occurrence_criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"const": "r2.pwnsat.status-occurrence"},
        "version": {"const": "0.1-story"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["id", "version", "sha256"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_seconds": {"type": "number", "exclusiveMinimum": 0},
        "pre_quiet_seconds": {"type": "number", "exclusiveMinimum": 0},
        "exclusive_command_source_control": {"const": true},
        "require_cleared_channel": {"const": true}
      },
      "required": ["window_seconds", "pre_quiet_seconds", "exclusive_command_source_control", "require_cleared_channel"]
    },
    "presentations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"id": {"enum": ["P1", "P2"]}},
        "required": ["id"]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "story_owned": {"const": true},
        "g0_0_1_story_unchanged": {"const": true},
        "note": {"type": "string", "minLength": 1}
      },
      "required": ["story_owned", "g0_0_1_story_unchanged", "note"]
    }
  },
  "required": ["kind", "format_version", "experiment", "scenario", "projection", "authorized_instance", "runtime_target", "occurrence_criterion", "observation", "presentations", "provenance"]
}
